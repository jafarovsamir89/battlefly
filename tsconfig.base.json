{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@battlefly/shared-types": ["packages/shared-types/src/index.ts"],
      "@battlefly/game-rules": ["packages/game-rules/src/index.ts"],
      "@battlefly/networking": ["packages/networking/src/index.ts"],
      "@battlefly/input": ["packages/input/src/index.ts"],
      "@battlefly/ui-core": ["packages/ui-core/src/index.ts"],
      "@battlefly/simulation": ["packages/simulation/src/index.ts"]
    },
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "allowJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
